# Local environment files. These hold credentials — the Cesium Ion token lives
# in frontend/.env.local — and must never be committed. Vite loads *.local
# automatically and its own docs treat these as git-ignored by convention.
.env.local
.env.*.local
*.env.local

# Virtual environments
venv/
ENV/
env/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Data (cached locally, not committed)
#
# ANCHORED to the repo root. A bare `data/` matches at ANY depth, which also
# excluded frontend/src/data/ — so entities.js, a source file that App.jsx,
# Map2D.jsx, Scene3D.jsx and ControlPanel.jsx all import, was silently never
# committed and a fresh clone could not build the frontend.
/data/
*.cache

# Node dependencies. tools/sih-presentation/ pulls in simple-icons + sharp only
# to regenerate the deck's technology-stack marks; the generated PNGs under
# assets/logos/ ARE committed, so building the deck never needs node.
node_modules/

# Deck render output — regenerate with tools/sih-presentation/export_pdf.ps1
tools/sih-presentation/render/
