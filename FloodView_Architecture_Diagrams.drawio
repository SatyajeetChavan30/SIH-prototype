          <mxGeometry x="242" y="186" width="218" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_20" value="Prepares the digital landscape, then models how the wall gives way -- how wide, how quickly, how much water is released." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=5.7;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="244" y="250" width="214" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_21" value="Terrain smoothing and artefact cleaning" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="242" y="312" width="218" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_22" value="Breach growth from published dam-safety work" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="242" y="362" width="218" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_23" value="Study-area definition around the dam" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="242" y="412" width="218" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_24" value="Ground cover mapped to how fast water flows" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="242" y="462" width="218" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_25" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.8;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="667" y="148" as="sourcePoint" />
            <mxPoint x="583" y="186" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2440_26" value="&lt;b&gt;Impact and Risk&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontSize=8.2;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="478" y="186" width="210" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_27" value="Turns depth into consequence: which areas, how deep, how many people, and what it is likely to cost." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=5.7;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="480" y="250" width="206" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_28" value="Four hazard classes, ankle-deep to above five metres" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4F4;strokeColor=#F1A8A8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="478" y="312" width="210" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_29" value="Building damage from published damage curves" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4F4;strokeColor=#F1A8A8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="478" y="362" width="210" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_30" value="Loss-of-life estimates from the standard tables" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4F4;strokeColor=#F1A8A8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="478" y="412" width="210" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_31" value="Population exposed, read from satellite data" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF4F4;strokeColor=#F1A8A8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="478" y="462" width="210" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_32" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.8;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="667" y="148" as="sourcePoint" />
            <mxPoint x="813" y="186" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2440_33" value="&lt;b&gt;Near-Dam 3D Physics&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=8.2;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="706" y="186" width="214" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_34" value="Optional detail for the violent water right at the wall. It adds resolution; it never replaces the main simulation." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=5.7;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="708" y="250" width="210" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_35" value="Hand-off from the flood solver, one direction only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F5FE;strokeColor=#CBB0F8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="706" y="312" width="214" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_36" value="A 3D domain roughly 600 metres across" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F5FE;strokeColor=#CBB0F8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="706" y="362" width="214" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_37" value="Particle-based water, about 15 seconds of it" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F5FE;strokeColor=#CBB0F8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="706" y="412" width="214" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_38" value="Overtopping and splash behaviour at the crest" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F5FE;strokeColor=#CBB0F8;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="706" y="462" width="214" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_39" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.8;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="667" y="148" as="sourcePoint" />
            <mxPoint x="1039" y="186" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2440_40" value="&lt;b&gt;Quality Assurance&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=8.2;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="938" y="186" width="202" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_41" value="Automated proof that must pass before a result is released. Four checks. Fail one and nothing is published." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=5.7;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="940" y="250" width="198" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_42" value="Still water must stay still" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="938" y="312" width="202" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_43" value="No water may be created or lost" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="938" y="362" width="202" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_44" value="No impossible depths anywhere in the grid" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="938" y="412" width="202" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_45" value="The answer must match the independent engine" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2FAF8;strokeColor=#9BD5C3;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="938" y="462" width="202" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_46" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.8;endArrow=none;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="667" y="148" as="sourcePoint" />
            <mxPoint x="1236" y="186" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p2440_47" value="&lt;b&gt;Reports and Maps&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=8.2;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1162" y="186" width="149" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_48" value="Everything a decision maker actually receives." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=5.7;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1164" y="250" width="145" height="58" as="geometry" />
        </mxCell>
        <mxCell id="p2440_49" value="Flood depth maps for standard mapping tools" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F6FE;strokeColor=#B9B5F5;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1162" y="312" width="149" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_50" value="Boundary shapes for planning software" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F6FE;strokeColor=#B9B5F5;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1162" y="362" width="149" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_51" value="Google Earth overlays" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F6FE;strokeColor=#B9B5F5;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1162" y="412" width="149" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_52" value="Time-lapse animation frames" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F6FE;strokeColor=#B9B5F5;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1162" y="462" width="149" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_53" value="Spreadsheets of arrival times" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F6FE;strokeColor=#B9B5F5;fontColor=#1F2937;fontSize=6.0;fontStyle=0;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1162" y="512" width="149" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p2440_54" value="The one rule the whole map obeys" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.4;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="562" width="602" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2440_55" value="A part may only depend on the parts to its left. That is why the near-dam 3D physics can be switched off entirely without touching anything else, and why the reporting stage can be rewritten without going near the mathematics. It is also what keeps each part testable on its own." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=#D97706;fontColor=#824704;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="594" width="602" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p2440_56" value="Supporting services" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.4;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="652" y="562" width="300" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p2440_57" value="&lt;b&gt;Settings Loader&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Reads the run settings and&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;checks them before anything starts&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEEF0;strokeColor=#475569;fontColor=#2E3744;fontSize=6.8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="652" y="594" width="206" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p2440_58" value="&lt;b&gt;Dam Profile Library&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Tehri, Khadakwasla and their&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;downstream towns, ready to run&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8EAEE;strokeColor=#14305A;fontColor=#0D1F3A;fontSize=6.8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="872" y="594" width="214" height="104" as="geometry" />
        </mxCell>
        <mxCell id="p2440_59" value="&lt;b&gt;Offline Cache&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Holds everything downloaded so&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;the next run needs no network&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEEF0;strokeColor=#475569;fontColor=#2E3744;fontSize=6.8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1102" y="594" width="209" height="104" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page7" name="7. Data Flow">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p6220_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1333" height="750" as="geometry" />
        </mxCell>
        <mxCell id="p6220_3" value="JalRaksha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;arcSize=40;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="14" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6220_4" value="PS 26161 · NTRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="50" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p6220_5" value="FROM RAW DATA TO A DECISION" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=20;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="8" width="955" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6220_6" value="Three stages. Collect once, simulate on demand, then publish something a district officer can act on." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="50" width="955" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p6220_7" value="SMART INDIA&lt;br&gt;HACKATHON 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#0070C0;fontSize=8;fontStyle=1;align=right;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1135" y="12" width="176" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6220_8" value="Stage one happens once per dam. Stages two and three happen every time somebody asks a question." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="716" width="1333" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6220_9" value="7" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8.5;fontStyle=1;align=right;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1260" y="716" width="50" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6220_10" value="STAGE 1 · COLLECT AND PREPARE" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=8.0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="22" y="96" width="320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6220_11" value="Runs once per dam, then never again -- the results are cached on disk." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.6;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="356" y="100" width="540" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p6220_12" value="&lt;b&gt;Fetch the Terrain&lt;/b&gt;&lt;br&gt;Satellite ground-height tiles at&lt;br&gt;30-metre detail, free from the&lt;br&gt;European Space Agency." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="142" width="240" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_13" value="&lt;b&gt;Stitch and Clean&lt;/b&gt;&lt;br&gt;Several tiles merged into one&lt;br&gt;seamless surface, with cliff and&lt;br&gt;water-body artefacts removed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0D9488;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="278" y="142" width="256" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_14" value="&lt;b&gt;Label the Ground&lt;/b&gt;&lt;br&gt;Forest, town or farmland -- this&lt;br&gt;is what sets how much the land&lt;br&gt;slows the water down." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="550" y="142" width="234" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_15" value="&lt;b&gt;Define the Study Area&lt;/b&gt;&lt;br&gt;Draw the box around the dam,&lt;br&gt;in metres rather than degrees,&lt;br&gt;on an even calculation grid." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="800" y="142" width="242" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_16" value="&lt;b&gt;Locate the Wall&lt;/b&gt;&lt;br&gt;Pin down exactly where the dam&lt;br&gt;sits and where the breach would&lt;br&gt;open. Everything keys off this." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1058" y="142" width="253" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_17" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="262" y="188" as="sourcePoint" />
            <mxPoint x="278" y="188" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_18" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="534" y="188" as="sourcePoint" />
            <mxPoint x="550" y="188" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_19" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="784" y="188" as="sourcePoint" />
            <mxPoint x="800" y="188" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_20" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1042" y="188" as="sourcePoint" />
            <mxPoint x="1058" y="188" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_21" style="html=1;strokeColor=#D97706;strokeWidth=2.2;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="234" as="sourcePoint" />
            <mxPoint x="510" y="272" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_22" value="terrain grid + breach position + ground-roughness map -&gt; handed to the simulation" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=6.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="530" y="238" width="660" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p6220_23" value="STAGE 2 · SIMULATE" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontSize=8.0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="22" y="280" width="320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6220_24" value="The whole of this stage completes in about 47 seconds for a full Tehri run." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.6;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="356" y="284" width="620" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p6220_25" value="&lt;b&gt;Model the Failure&lt;/b&gt;&lt;br&gt;Breach width, how fast it opens,&lt;br&gt;and the peak water released.&lt;br&gt;Thirty variations, not one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EA580C;strokeColor=#EA580C;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="326" width="232" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_26" value="&lt;b&gt;Spread the Water&lt;/b&gt;&lt;br&gt;Every cell of the landscape,&lt;br&gt;second by second, downstream.&lt;br&gt;The core of the whole system." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="270" y="326" width="262" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_27" value="&lt;b&gt;Sweep the Uncertainty&lt;/b&gt;&lt;br&gt;Different breach sizes give&lt;br&gt;different outcomes. The answer&lt;br&gt;is a band, not a point." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0D9488;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="548" y="326" width="230" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_28" value="&lt;b&gt;Time the Arrivals&lt;/b&gt;&lt;br&gt;When does the water reach each&lt;br&gt;town? This is the number an&lt;br&gt;evacuation order depends on." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="794" y="326" width="246" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_29" value="&lt;b&gt;Optional 3D Detail&lt;/b&gt;&lt;br&gt;Violent water at the wall itself.&lt;br&gt;About 600 metres, 15 seconds.&lt;br&gt;It can never reach a town." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1056" y="326" width="255" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_30" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="254" y="372" as="sourcePoint" />
            <mxPoint x="270" y="372" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_31" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="532" y="372" as="sourcePoint" />
            <mxPoint x="548" y="372" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_32" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="778" y="372" as="sourcePoint" />
            <mxPoint x="794" y="372" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_33" style="html=1;strokeColor=#0284C7;strokeWidth=1.6;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1040" y="372" as="sourcePoint" />
            <mxPoint x="1056" y="372" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_34" style="html=1;strokeColor=#D97706;strokeWidth=2.2;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="510" y="418" as="sourcePoint" />
            <mxPoint x="510" y="456" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6220_35" value="maximum depth + arrival time + the percentile band -&gt; handed to the reporting stage" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=6.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="530" y="422" width="680" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p6220_36" value="STAGE 3 · PUBLISH" style="shape=step;perimeter=stepPerimeter;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=8.0;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="22" y="464" width="320" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6220_37" value="Nothing reaches this stage until all four quality gates have passed." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.6;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="356" y="468" width="660" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p6220_38" value="&lt;b&gt;Score the Impact&lt;/b&gt;&lt;br&gt;How deep in each area, how many&lt;br&gt;people exposed, and the likely&lt;br&gt;damage -- with the source stated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="510" width="252" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_39" value="&lt;b&gt;Draw the Flood Maps&lt;/b&gt;&lt;br&gt;Colour-coded depth maps that open&lt;br&gt;in any standard mapping tool, plus&lt;br&gt;Google Earth overlays." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="290" y="510" width="238" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_40" value="&lt;b&gt;Render the Animation&lt;/b&gt;&lt;br&gt;Time-lapse of the flood spreading,&lt;br&gt;for briefings and for public&lt;br&gt;awareness material." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="544" y="510" width="230" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_41" value="&lt;b&gt;Fill the Dashboard&lt;/b&gt;&lt;br&gt;Maps, globe, charts, gauge traces&lt;br&gt;and every download, live in the&lt;br&gt;browser. Nothing to install." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="790" y="510" width="244" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_42" value="&lt;b&gt;Attach the Evidence&lt;/b&gt;&lt;br&gt;The four gate results and the&lt;br&gt;independent cross-check travel&lt;br&gt;with the report, every time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1050" y="510" width="261" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p6220_43" value="The one-way arrow matters. The near-dam 3D physics reads the flood solver&#39;s output and refines it. It never feeds back. Anyone claiming a two-way coupling here would be overstating what was built." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EBFD;strokeColor=#7C3AED;fontColor=#4A238E;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="624" width="640" height="56" as="geometry" />
        </mxCell>
        <mxCell id="p6220_44" value="Stage one is the reason this works offline. Once a dam&#39;s terrain has been fetched, the entire pipeline runs with the network unplugged -- which is the assumption demo day is built on." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#059669;fontColor=#035A3F;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="686" y="624" width="625" height="56" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page8" name="8. Why It Matters">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3755_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1333" height="750" as="geometry" />
        </mxCell>
        <mxCell id="p3755_3" value="JalRaksha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;arcSize=40;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="14" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_4" value="PS 26161 · NTRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="50" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3755_5" value="WHY IT MATTERS" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=20;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="8" width="955" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3755_6" value="India has more than five thousand large dams, many of them ageing. Today only a handful ever get studied." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="50" width="955" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3755_7" value="SMART INDIA&lt;br&gt;HACKATHON 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#0070C0;fontSize=8;fontStyle=1;align=right;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1135" y="12" width="176" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3755_8" value="The point is not a better flood model. The point is that every dam can be screened, not just the funded ones." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="716" width="1333" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_9" value="8" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8.5;fontStyle=1;align=right;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1260" y="716" width="50" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_10" value="A conventional dam-break study takes &lt;b&gt;weeks&lt;/b&gt; of specialist time and licensed software, so it is only commissioned for the dams somebody has already worried about.&lt;br&gt;JalRaksha completes the same screening in &lt;b&gt;minutes&lt;/b&gt;, from free satellite data -- which changes who gets screened, not just how fast." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8ECF7;strokeColor=#1E40AF;fontColor=#1F2937;fontSize=9;fontStyle=1;align=left;verticalAlign=middle;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="96" width="1289" height="62" as="geometry" />
        </mxCell>
        <mxCell id="p3755_11" value="&lt;b&gt;&lt;font color=&quot;#04704F&quot;&gt;SAVES LIVES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ Arrival times per town -- the number that sets an evacuation order&lt;br&gt;▪ Flood extent showing which areas to clear, and in what order&lt;br&gt;▪ Population exposed, estimated from satellite data&lt;br&gt;▪ Works with the network unplugged, when it matters most" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#059669;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="176" width="316" height="166" as="geometry" />
        </mxCell>
        <mxCell id="p3755_12" value="&lt;b&gt;&lt;font color=&quot;#A35904&quot;&gt;SAVES MONEY&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ No software licence to buy -- every component is open&lt;br&gt;▪ No field survey needed before the first map exists&lt;br&gt;▪ Minutes per dam instead of weeks&lt;br&gt;▪ Run by a trained officer, not a hired specialist" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF5EE;strokeColor=#D97706;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="352" y="176" width="302" height="152" as="geometry" />
        </mxCell>
        <mxCell id="p3755_13" value="&lt;b&gt;&lt;font color=&quot;#0A6F66&quot;&gt;HONEST BY DESIGN&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ Reports a range, never a single falsely precise number&lt;br&gt;▪ Poor satellite imagery is refused, not quietly used&lt;br&gt;▪ Four quality gates block a bad result rather than flagging it&lt;br&gt;▪ Every limitation is stated on the report itself" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F7;strokeColor=#0D9488;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="668" y="176" width="330" height="172" as="geometry" />
        </mxCell>
        <mxCell id="p3755_14" value="&lt;b&gt;&lt;font color=&quot;#5D2CB2&quot;&gt;INDEPENDENTLY CHECKED&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ Matched against Delft3D FM on the same textbook case&lt;br&gt;▪ Our error 0.0317 m, theirs 0.0349 m&lt;br&gt;▪ Both engines agree to within 0.0294 m&lt;br&gt;▪ Built on two decades of published dam-safety research" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F1FE;strokeColor=#7C3AED;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1012" y="176" width="299" height="158" as="geometry" />
        </mxCell>
        <mxCell id="p3755_15" value="How that compares with current practice" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=10;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="362" width="600" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p3755_16" value="What you need" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=7.2;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="396" width="282" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_17" value="How it is done today" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=7.2;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="308" y="396" width="466" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_18" value="How JalRaksha does it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=7.2;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="396" width="535" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_19" value="Time to a first answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="434" width="282" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_20" value="Weeks of specialist setup" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFD;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="308" y="434" width="466" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_21" value="Minutes -- pick a dam and press run" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFD;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="434" width="535" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_22" value="Data you must buy" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="472" width="282" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_23" value="Licensed elevation data plus a field survey" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="308" y="472" width="466" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_24" value="None. Free satellite data, cached locally" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="472" width="535" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_25" value="Independent verification" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="510" width="282" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_26" value="Rarely available, rarely published" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFD;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="308" y="510" width="466" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_27" value="Cross-checked against Delft3D FM, published here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFD;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="510" width="535" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_28" value="How uncertainty is shown" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="548" width="282" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_29" value="A single number, with no band around it" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="308" y="548" width="466" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_30" value="Thirty runs -- best, worst and most likely" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="548" width="535" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_31" value="Poor satellite imagery" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="586" width="282" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_32" value="Used anyway, because there is nothing else" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFD;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="308" y="586" width="466" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_33" value="Refused automatically below the quality threshold" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F5FAFD;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="586" width="535" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_34" value="Network on the day" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="624" width="282" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_35" value="Required -- the tools are cloud-hosted" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="308" y="624" width="466" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_36" value="Not required. Everything runs from cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#8DC8E6;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="778" y="624" width="535" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3755_37" value="Refusing a bad input is a feature, not a gap. At Khadakwasla the radar scene scored 0.486 against a 0.5 threshold and was rejected outright -- no substitute overlay was drawn in its place." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE9E9;strokeColor=#DC2626;fontColor=#841717;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="658" width="630" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3755_38" value="None of the right-hand column is aspiration. Every row in it is running today, on the machine this deck was built on, and the numbers quoted came off that machine." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#059669;fontColor=#035A3F;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="676" y="658" width="635" height="44" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page9" name="9. Validation">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8140_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1333" height="750" as="geometry" />
        </mxCell>
        <mxCell id="p8140_3" value="JalRaksha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;arcSize=40;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="14" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8140_4" value="PS 26161 · NTRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="50" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p8140_5" value="HOW WE KNOW THE ANSWERS ARE RIGHT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=20;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="8" width="955" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p8140_6" value="Four checks that must pass, plus a comparison against an engine we did not write." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="50" width="955" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p8140_7" value="SMART INDIA&lt;br&gt;HACKATHON 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#0070C0;fontSize=8;fontStyle=1;align=right;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1135" y="12" width="176" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p8140_8" value="If a check fails, the result is blocked -- not flagged, not footnoted. Blocked." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="716" width="1333" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8140_9" value="9" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8.5;fontStyle=1;align=right;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1260" y="716" width="50" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8140_10" value="No result is ever shown until all four checks pass. A warning label on a wrong flood map is worse than no map at all, so a failed check stops the run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FAE1E1;strokeColor=#DC2626;fontColor=#9A1B1B;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="96" width="1289" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p8140_11" value="&lt;b&gt;&lt;font color=&quot;#04704F&quot;&gt;CHECK 1 · STILL WATER STAYS STILL&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Water in a bowl with nothing pushing it must not drift.&lt;br&gt;Measured drift: 0.0000000000000598 metres per second.&lt;br&gt;The threshold allows a thousand times more than that.&lt;br&gt;Result: passes, with room to spare." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#059669;fontColor=#1F2937;fontSize=6.2;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="168" width="316" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8140_12" value="&lt;b&gt;&lt;font color=&quot;#04704F&quot;&gt;CHECK 2 · NO WATER APPEARS OR VANISHES&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Total water in the simulation must stay constant.&lt;br&gt;Measured loss across a thousand steps: 0.000000 per cent.&lt;br&gt;Exact to the limit of what the machine can represent.&lt;br&gt;Result: passes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#059669;fontColor=#1F2937;fontSize=6.2;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="354" y="168" width="306" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8140_13" value="&lt;b&gt;&lt;font color=&quot;#04704F&quot;&gt;CHECK 3 · NO IMPOSSIBLE NUMBERS&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Depth can never be negative, and nothing may go undefined.&lt;br&gt;The flood edge, where water meets dry ground, is the hard part.&lt;br&gt;Every cell across every test case stayed physical.&lt;br&gt;Result: passes on all cases." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#059669;fontColor=#1F2937;fontSize=6.2;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="682" y="168" width="310" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8140_14" value="&lt;b&gt;&lt;font color=&quot;#04704F&quot;&gt;CHECK 4 · MATCHES THE KNOWN ANSWER&lt;/font&gt;&lt;/b&gt;&lt;br&gt;A textbook dam-break has an exact answer written in 1892.&lt;br&gt;Exact depth at the wall: 4.444 metres.&lt;br&gt;Our answer: 4.532 metres -- an error of about 3 centimetres.&lt;br&gt;Result: passes, well inside tolerance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F4;strokeColor=#059669;fontColor=#1F2937;fontSize=6.2;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1014" y="168" width="297" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p8140_15" value="And then checked against an engine we did not write" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#632EBE;fontSize=11;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="306" width="800" height="28" as="geometry" />
        </mxCell>
        <mxCell id="p8140_16" value="&lt;b&gt;&lt;font color=&quot;#5D2CB2&quot;&gt;What was actually done&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ The same textbook case was run twice -- once through our engine, once through Delft3D FM.&lt;br&gt;▪ Delft3D FM is made by Deltares, an independent Dutch institute. Governments use it for real flood studies.&lt;br&gt;▪ It is a genuine Deltares kernel running here, 2026.01 build -- not a re-implementation of ours.&lt;br&gt;▪ Both runs were scored against the exact mathematical answer, over the interior of the domain.&lt;br&gt;▪ Neither engine was tuned to match the other." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F1FE;strokeColor=#7C3AED;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="342" width="462" height="198" as="geometry" />
        </mxCell>
        <mxCell id="p8140_17" value="Ten metres of water, a flat frictionless bed, ten-metre cells, forty seconds of flow, and the three outermost cells at each end trimmed before scoring. Anyone can repeat it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F2EBFD;strokeColor=#7C3AED;fontColor=#4A238E;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="552" width="462" height="72" as="geometry" />
        </mxCell>
        <mxCell id="p8140_18" value="The result" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#5D2CB2;fontSize=8.8;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="506" y="344" width="400" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8140_19" value="Engine" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="506" y="378" width="275" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_20" value="Error against the exact answer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="785" y="378" width="185" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_21" value="Depth at the wall" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="974" y="378" width="155" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_22" value="Verdict" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#7C3AED;strokeColor=#7C3AED;fontColor=#FFFFFF;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1133" y="378" width="178" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_23" value="JalRaksha" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3FC;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="506" y="418" width="275" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_24" value="0.0317 m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF7FE;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="785" y="418" width="185" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_25" value="4.532 m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF7FE;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="974" y="418" width="155" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_26" value="passes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF7FE;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1133" y="418" width="178" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_27" value="Delft3D FM (Deltares)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3FC;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="506" y="458" width="275" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_28" value="0.0349 m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2EBFD;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="785" y="458" width="185" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_29" value="4.515 m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2EBFD;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="974" y="458" width="155" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_30" value="passes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F2EBFD;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1133" y="458" width="178" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_31" value="The exact answer (1892)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#EDE3FC;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="506" y="498" width="275" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_32" value="reference" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF7FE;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="785" y="498" width="185" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_33" value="4.444 m" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF7FE;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="974" y="498" width="155" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_34" value="reference" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FAF7FE;strokeColor=#C4A6F7;fontColor=#1F2937;fontSize=6.4;fontStyle=0;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1133" y="498" width="178" height="36" as="geometry" />
        </mxCell>
        <mxCell id="p8140_35" value="The two engines agree with each other to 0.0294 metres. Ten metres of water standing behind the wall, forty seconds of flow, and the whole disagreement between them is under three centimetres." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F4F0;strokeColor=#059669;fontColor=#035A3F;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="506" y="536" width="530" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p8140_36" value="&lt;b&gt;4 / 4 GATES PASSED&lt;/b&gt;&lt;br&gt;&lt;i&gt;and within 3 cm of Delft3D FM&lt;/i&gt;" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DCF0EA;strokeColor=#059669;fontColor=#04694A;fontSize=10;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1062" y="532" width="249" height="96" as="geometry" />
        </mxCell>
        <mxCell id="p8140_37" value="&lt;b&gt;In plain words:&lt;/b&gt; the flood predictions here are as accurate as the software governments already trust, and we can show the working. What we do not claim is equally clear -- at 30-metre terrain detail, trust the arrival times and the flood boundary; treat any single depth reading as indicative." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=#D97706;fontColor=#1F2937;fontSize=8.4;fontStyle=1;align=left;verticalAlign=middle;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="644" width="1289" height="56" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page10" name="10. Deployment &amp; Roadmap">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p8731_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1333" height="750" as="geometry" />
        </mxCell>
        <mxCell id="p8731_3" value="JalRaksha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;arcSize=40;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="14" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8731_4" value="PS 26161 · NTRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="50" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p8731_5" value="HOW IT RUNS, WHAT IS NEW, WHAT COMES NEXT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=20;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="8" width="955" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p8731_6" value="Packaged to run on one laptop or one server, with no network and no licence." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="50" width="955" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p8731_7" value="SMART INDIA&lt;br&gt;HACKATHON 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#0070C0;fontSize=8;fontStyle=1;align=right;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1135" y="12" width="176" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p8731_8" value="Everything on the left of this slide already works. The right-hand column is what we build after the hackathon." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="716" width="1333" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8731_9" value="10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8.5;fontStyle=1;align=right;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1260" y="716" width="50" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p8731_10" value="How it runs" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=11;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="94" width="360" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8731_11" value="&lt;b&gt;A Browser&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Chrome, Firefox or Edge. Nothing to install,&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;nothing to configure.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#0284C7;fontColor=#015681;fontSize=7.6;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="126" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p8731_12" value="&lt;b&gt;The Web Service&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Answers in about a fifth of a second, even&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;while a simulation is running.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E7F4F3;strokeColor=#0D9488;fontColor=#086058;fontSize=7.6;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="228" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p8731_13" value="&lt;b&gt;The Simulation Worker&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;A separate process, so a heavy calculation&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;can never freeze the page.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEEE7;strokeColor=#EA580C;fontColor=#983908;fontSize=7.6;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="330" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p8731_14" value="&lt;b&gt;Local Storage&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;Results and cached terrain, held on the&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;machine&#39;s own disk.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEEF0;strokeColor=#475569;fontColor=#2E3744;fontSize=7.6;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="432" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p8731_15" value="&lt;b&gt;One Container&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;The whole system packaged so it starts&lt;/font&gt;&lt;br&gt;&lt;font color=&quot;#6B7280&quot;&gt;anywhere with a single command.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDECFC;strokeColor=#4F46E5;fontColor=#332E95;fontSize=7.6;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="534" width="360" height="88" as="geometry" />
        </mxCell>
        <mxCell id="p8731_16" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="202" y="214" as="sourcePoint" />
            <mxPoint x="202" y="228" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p8731_17" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="202" y="316" as="sourcePoint" />
            <mxPoint x="202" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p8731_18" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="202" y="418" as="sourcePoint" />
            <mxPoint x="202" y="432" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p8731_19" style="html=1;strokeColor=#9CA3AF;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="202" y="520" as="sourcePoint" />
            <mxPoint x="202" y="534" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p8731_20" value="What is genuinely new here" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=11;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="406" y="94" width="520" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8731_21" value="&lt;b&gt;Verified, not asserted&lt;/b&gt;&lt;br&gt;Cross-checked against a real Deltares kernel&lt;br&gt;running on this machine -- demonstrated, not claimed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EFFE;strokeColor=#7C3AED;fontColor=#51269A;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="406" y="126" width="252" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_22" value="&lt;b&gt;A range, not a number&lt;/b&gt;&lt;br&gt;Thirty variations every run, reported as a&lt;br&gt;percentile band around the arrival time." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECF6F5;strokeColor=#0D9488;fontColor=#086058;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="672" y="126" width="254" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_23" value="&lt;b&gt;Bad data is refused&lt;/b&gt;&lt;br&gt;A radar scene below the quality threshold is&lt;br&gt;rejected outright. No synthetic stand-in is ever drawn." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCEEEE;strokeColor=#DC2626;fontColor=#8F1919;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="406" y="236" width="252" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_24" value="&lt;b&gt;Honest progress&lt;/b&gt;&lt;br&gt;The dashboard reports which member of thirty is&lt;br&gt;solving, rather than a bar that sits still." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#0284C7;fontColor=#015681;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="672" y="236" width="254" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_25" value="&lt;b&gt;Runs with no network&lt;/b&gt;&lt;br&gt;Everything cached after the first fetch, because&lt;br&gt;demo-day connectivity cannot be assumed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF2EC;strokeColor=#EA580C;fontColor=#983908;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="406" y="346" width="252" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_26" value="&lt;b&gt;Near-dam 3D detail&lt;/b&gt;&lt;br&gt;Particle physics at the wall, handed off in one&lt;br&gt;direction only -- about 600 metres, 15 seconds." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5EFFE;strokeColor=#7C3AED;fontColor=#51269A;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="672" y="346" width="254" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_27" value="&lt;b&gt;Replaceable parts&lt;/b&gt;&lt;br&gt;Any component can be swapped without touching&lt;br&gt;the others, because dependencies run one way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F1F0FD;strokeColor=#4F46E5;fontColor=#332E95;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="406" y="456" width="252" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_28" value="&lt;b&gt;Zero licence cost&lt;/b&gt;&lt;br&gt;Every component is open-source. There is nothing&lt;br&gt;to buy before a state can use it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EBF7F3;strokeColor=#059669;fontColor=#036244;fontSize=7.2;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="672" y="456" width="254" height="100" as="geometry" />
        </mxCell>
        <mxCell id="p8731_29" value="Where it goes next" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=11;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="952" y="94" width="360" height="26" as="geometry" />
        </mxCell>
        <mxCell id="p8731_30" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;DONE&lt;/font&gt;&lt;/b&gt;&lt;br&gt;– The flood simulation engine&lt;br&gt;– The dashboard, eight working tabs&lt;br&gt;– All four quality gates passing&lt;br&gt;– The independent Delft3D cross-check&lt;br&gt;– Thirty-member uncertainty sweep&lt;br&gt;– Offline-first caching&lt;br&gt;– Single-command container" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F9F6;strokeColor=#059669;fontColor=#1F2937;fontSize=6.6;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="952" y="126" width="359" height="220" as="geometry" />
        </mxCell>
        <mxCell id="p8731_31" value="DONE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="964" y="115" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p8731_32" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;NOW&lt;/font&gt;&lt;/b&gt;&lt;br&gt;– Impact analysis, final pass&lt;br&gt;– Near-dam 3D integration polish&lt;br&gt;– Demo-day rehearsal and fallbacks" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDF7F0;strokeColor=#D97706;fontColor=#1F2937;fontSize=6.6;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="952" y="360" width="359" height="140" as="geometry" />
        </mxCell>
        <mxCell id="p8731_33" value="NOW" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D97706;strokeColor=#D97706;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="964" y="349" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p8731_34" value="&lt;b&gt;&lt;font color=&quot;#FFFFFF&quot;&gt;NEXT&lt;/font&gt;&lt;/b&gt;&lt;br&gt;– Screen all five thousand registered dams&lt;br&gt;– Hand results to district authorities directly&lt;br&gt;– Alerts to the phones of people downstream&lt;br&gt;– A hosted service for states without hardware&lt;br&gt;– Feed Tier-2 detailed studies where warranted" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F0F8FC;strokeColor=#0284C7;fontColor=#1F2937;fontSize=6.6;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="952" y="514" width="359" height="128" as="geometry" />
        </mxCell>
        <mxCell id="p8731_35" value="NEXT" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="964" y="503" width="80" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p8731_36" value="The framing matters as much as the software. JalRaksha is a first-pass screening instrument: it tells a state which of its dams deserve a full surveyed study, and in what order. It does not replace that study, and the reports say so on their own face rather than in a footnote." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBF1E6;strokeColor=#D97706;fontColor=#824704;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="406" y="576" width="520" height="122" as="geometry" />
        </mxCell>
        <mxCell id="p8731_37" value="One laptop is enough to run all of this. Nothing here assumes a data centre, a licence server or a working connection." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6F3F9;strokeColor=#0284C7;fontColor=#014F77;fontSize=6.4;fontStyle=3;align=left;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="632" width="360" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p8731_38" value="None of the last block has been started. It is listed so the boundary between what runs and what is planned stays visible." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDEEF0;strokeColor=#475569;fontColor=#2B333F;fontSize=6.4;fontStyle=3;align=center;verticalAlign=middle;arcSize=10;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="952" y="656" width="359" height="42" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
