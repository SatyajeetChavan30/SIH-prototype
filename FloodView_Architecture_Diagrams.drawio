          <mxGeometry relative="1" as="geometry">
            <mxPoint x="976" y="431" as="sourcePoint" />
            <mxPoint x="1018" y="431" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_43" value="&lt;b&gt;Watches the arrival times appear&lt;/b&gt;&lt;br&gt;&lt;i&gt;Town by town.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#0284C7;fontColor=#014F77;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="36" y="490" width="278" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3432_44" value="&lt;b&gt;Saves each result as it lands&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nothing is lost on a crash.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0EE;strokeColor=#0D9488;fontColor=#085952;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="358" y="490" width="294" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3432_45" value="&lt;b&gt;Scores impact: depth, hazard, people exposed&lt;/b&gt;&lt;br&gt;&lt;i&gt;Published formulas.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E4F4;strokeColor=#1E40AF;fontColor=#122669;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="694" y="490" width="282" height="80" as="geometry" />
        </mxCell>
        <mxCell id="p3432_46" value="&lt;b&gt;Plots the flood on a 2D map and a 3D globe&lt;/b&gt;&lt;br&gt;&lt;i&gt;Both stay loaded.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E5FB;strokeColor=#4F46E5;fontColor=#2F2A89;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
