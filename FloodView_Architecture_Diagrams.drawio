        </mxCell>
        <mxCell id="p1211_20" value="Choose a dam and set the failure scenario" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CFEAE7;strokeColor=#0D9488;fontColor=#086058;fontSize=6.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="260" y="114" width="318" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p1211_21" value="Run a full flood simulation -- minutes, not weeks" style="ellipse;whiteSpace=wrap;html=1;fillColor=#D2D9EF;strokeColor=#1E40AF;fontColor=#142A72;fontSize=6.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
