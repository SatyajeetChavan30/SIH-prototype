        <mxCell id="p3432_2" value="" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="0" width="1333" height="750" as="geometry" />
        </mxCell>
        <mxCell id="p3432_3" value="JalRaksha" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;arcSize=40;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="14" width="130" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3432_4" value="PS 26161 · NTRO" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=0;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="50" width="160" height="20" as="geometry" />
        </mxCell>
        <mxCell id="p3432_5" value="USER JOURNEY -- WHO DOES WHAT" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=20;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="8" width="955" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3432_6" value="Four lanes. The officer clicks; everything to the right of that happens on its own." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="50" width="955" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p3432_7" value="SMART INDIA&lt;br&gt;HACKATHON 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#0070C0;fontSize=8;fontStyle=1;align=right;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1135" y="12" width="176" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p3432_8" value="The person operating the system makes five decisions. The system takes roughly twenty thousand." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="716" width="1333" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3432_9" value="3" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8.5;fontStyle=1;align=right;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1260" y="716" width="50" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3432_10" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FAFD;strokeColor=#0284C7;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=3;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="128" width="306" height="562" as="geometry" />
        </mxCell>
        <mxCell id="p3432_11" value="THE OFFICER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="36" y="116" width="101" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3432_12" value="A dam-safety or disaster-management officer. No coding background." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="32" y="146" width="286" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3432_13" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F5FBFA;strokeColor=#0D9488;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=3;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="344" y="128" width="322" height="562" as="geometry" />
        </mxCell>
        <mxCell id="p3432_14" value="THE COORDINATOR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0D9488;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="358" y="116" width="129" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3432_15" value="Receives the request, checks it, and decides what work to start." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="354" y="146" width="302" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3432_16" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F7FC;strokeColor=#1E40AF;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=3;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="680" y="128" width="310" height="562" as="geometry" />
        </mxCell>
        <mxCell id="p3432_17" value="THE ENGINE" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="694" y="116" width="94" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3432_18" value="Does the mathematics: breach, flood spread, impact." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="690" y="146" width="290" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3432_19" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8F8FE;strokeColor=#4F46E5;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=3;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1004" y="128" width="307" height="562" as="geometry" />
        </mxCell>
        <mxCell id="p3432_20" value="THE REPORTER" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1018" y="116" width="108" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p3432_21" value="Turns results into maps, charts and files people can act on." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=6.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1014" y="146" width="287" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p3432_22" value="&lt;b&gt;Opens the dashboard in a browser&lt;/b&gt;&lt;br&gt;&lt;i&gt;Nothing to install.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#0284C7;fontColor=#014F77;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="36" y="182" width="278" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_23" value="&lt;b&gt;Answers in under a fifth of a second&lt;/b&gt;&lt;br&gt;&lt;i&gt;Even mid-run.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0EE;strokeColor=#0D9488;fontColor=#085952;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="358" y="182" width="294" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_24" value="&lt;b&gt;Idle, waiting for work&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E4F4;strokeColor=#1E40AF;fontColor=#122669;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="694" y="182" width="282" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_25" value="&lt;b&gt;Shows the run picker&lt;/b&gt;&lt;br&gt;&lt;i&gt;Any past run loads instantly.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E5FB;strokeColor=#4F46E5;fontColor=#2F2A89;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1018" y="182" width="279" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_26" style="html=1;strokeColor=#475569;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="314" y="225" as="sourcePoint" />
            <mxPoint x="358" y="225" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_27" style="html=1;strokeColor=#475569;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="652" y="225" as="sourcePoint" />
            <mxPoint x="694" y="225" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_28" style="html=1;strokeColor=#475569;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="976" y="225" as="sourcePoint" />
            <mxPoint x="1018" y="225" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_29" value="&lt;b&gt;Picks a dam -- say Tehri, 260 m&lt;/b&gt;&lt;br&gt;&lt;i&gt;Or types four numbers.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#0284C7;fontColor=#014F77;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="36" y="286" width="278" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_30" value="&lt;b&gt;Checks the inputs are physically sensible&lt;/b&gt;&lt;br&gt;&lt;i&gt;Rejects nonsense early.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0EE;strokeColor=#0D9488;fontColor=#085952;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="358" y="286" width="294" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_31" value="&lt;b&gt;Loads terrain, or fetches it once&lt;/b&gt;&lt;br&gt;&lt;i&gt;yes -&gt; straight through · no -&gt; fetched once, then kept&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E4F4;strokeColor=#1E40AF;fontColor=#122669;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="694" y="286" width="282" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_32" value="&lt;b&gt;Draws the study area on the map&lt;/b&gt;&lt;br&gt;&lt;i&gt;Confirms before running.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E5FB;strokeColor=#4F46E5;fontColor=#2F2A89;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1018" y="286" width="279" height="86" as="geometry" />
        </mxCell>
        <mxCell id="p3432_33" style="html=1;strokeColor=#475569;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="314" y="329" as="sourcePoint" />
            <mxPoint x="358" y="329" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_34" style="html=1;strokeColor=#475569;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="652" y="329" as="sourcePoint" />
            <mxPoint x="694" y="329" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_35" style="html=1;strokeColor=#475569;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="976" y="329" as="sourcePoint" />
            <mxPoint x="1018" y="329" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_36" value="&lt;b&gt;Keeps the defaults, presses Run&lt;/b&gt;&lt;br&gt;&lt;i&gt;One button.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#0284C7;fontColor=#014F77;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="36" y="390" width="278" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3432_37" value="&lt;b&gt;Starts a separate worker for the heavy part&lt;/b&gt;&lt;br&gt;&lt;i&gt;The page stays alive.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0EE;strokeColor=#0D9488;fontColor=#085952;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="358" y="390" width="294" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3432_38" value="&lt;b&gt;Models the breach, then the flood spread&lt;/b&gt;&lt;br&gt;&lt;i&gt;Thirty variations.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E4F4;strokeColor=#1E40AF;fontColor=#122669;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="694" y="390" width="282" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3432_39" value="&lt;b&gt;Streams live progress, member by member&lt;/b&gt;&lt;br&gt;&lt;i&gt;Never a frozen bar.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E6E5FB;strokeColor=#4F46E5;fontColor=#2F2A89;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1018" y="390" width="279" height="82" as="geometry" />
        </mxCell>
        <mxCell id="p3432_40" style="html=1;strokeColor=#475569;strokeWidth=0.9;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
