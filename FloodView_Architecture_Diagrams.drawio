        </mxCell>
        <mxCell id="p1211_22" value="Run thirty what-if variations for an honest range" style="ellipse;whiteSpace=wrap;html=1;fillColor=#CFEAE7;strokeColor=#0D9488;fontColor=#086058;fontSize=6.5;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
