        </mxCell>
        <mxCell id="p1211_6" value="Four kinds of user inside the country, four data services outside it, twelve things the system does." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
