          </mxGeometry>
        </mxCell>
        <mxCell id="p3432_50" value="&lt;b&gt;Downloads the pack for the district authority&lt;/b&gt;&lt;br&gt;&lt;i&gt;Ready to circulate.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCEEF7;strokeColor=#0284C7;fontColor=#014F77;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="36" y="586" width="278" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3432_51" value="&lt;b&gt;Attaches the quality-gate evidence&lt;/b&gt;&lt;br&gt;&lt;i&gt;Every run, no exceptions.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDF0EE;strokeColor=#0D9488;fontColor=#085952;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="358" y="586" width="294" height="90" as="geometry" />
        </mxCell>
        <mxCell id="p3432_52" value="&lt;b&gt;Optionally runs the near-dam 3D detail&lt;/b&gt;&lt;br&gt;&lt;i&gt;About 600 m, 15 s.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0E4F4;strokeColor=#1E40AF;fontColor=#122669;fontSize=6.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=8;spacing=4;" vertex="1" parent="1">
