        <mxCell id="p6956_5" value="HOW IT WORKS -- STEP BY STEP" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#1F2937;fontSize=20;fontStyle=1;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="8" width="955" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6956_6" value="From four simple inputs to a complete flood risk report, in minutes rather than weeks." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#6B7280;fontSize=8.2;fontStyle=2;align=left;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="170" y="50" width="955" height="22" as="geometry" />
        </mxCell>
        <mxCell id="p6956_7" value="SMART INDIA&lt;br&gt;HACKATHON 2026" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#0070C0;fontSize=8;fontStyle=1;align=right;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1135" y="12" width="176" height="44" as="geometry" />
        </mxCell>
        <mxCell id="p6956_8" value="Seven steps. The officer performs step one. The system performs the other six." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8;fontStyle=1;align=left;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="0" y="716" width="1333" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6956_9" value="2" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#0070C0;strokeColor=#0070C0;fontColor=#FFFFFF;fontSize=8.5;fontStyle=1;align=right;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1260" y="716" width="50" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p6956_10" value="&lt;b&gt;&lt;font color=&quot;#0A6F66&quot;&gt;Built-in uncertainty, not a single guess&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ Thirty variations run with different breach sizes&lt;br&gt;▪ Reports the fifth and ninety-fifth percentile arrival band&lt;br&gt;▪ Best case, worst case and most likely -- stated together&lt;br&gt;▪ This is how real engineering reports risk" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EEF8F7;strokeColor=#0D9488;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="94" width="410" height="144" as="geometry" />
        </mxCell>
        <mxCell id="p6956_11" value="&lt;b&gt;&lt;font color=&quot;#5D2CB2&quot;&gt;Checked against an independent engine&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ The same textbook case run through Delft3D FM as well&lt;br&gt;▪ A real Deltares kernel, not a lookalike of our own&lt;br&gt;▪ Our answer 0.0317 m error, theirs 0.0349 m&lt;br&gt;▪ The two engines agree to within 0.0294 m" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F6F1FE;strokeColor=#7C3AED;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="452" y="94" width="428" height="144" as="geometry" />
        </mxCell>
        <mxCell id="p6956_12" value="&lt;b&gt;&lt;font color=&quot;#A35904&quot;&gt;Why the speed matters&lt;/font&gt;&lt;/b&gt;&lt;br&gt;▪ Today: weeks of specialist setup and licensed software&lt;br&gt;▪ Today: field survey costs before a single map exists&lt;br&gt;▪ JalRaksha: four inputs, free data, a full run in 47 seconds&lt;br&gt;▪ Any trained officer can run it -- and it runs offline" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCF5EE;strokeColor=#D97706;fontColor=#1F2937;fontSize=6.4;fontStyle=1;align=left;verticalAlign=top;arcSize=5;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="900" y="94" width="411" height="144" as="geometry" />
        </mxCell>
        <mxCell id="p6956_13" value="&lt;b&gt;1. Pick a Dam&lt;/b&gt;&lt;br&gt;Choose from the list, or type in&lt;br&gt;position, height and storage.&lt;br&gt;Four numbers, nothing more." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#475569;strokeColor=#475569;fontColor=#FFFFFF;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="272" width="176" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p6956_14" value="No specialist needed -- the numbers are public." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=5.9;fontStyle=2;align=center;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="444" width="176" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p6956_15" value="&lt;b&gt;2. Get the Terrain&lt;/b&gt;&lt;br&gt;Satellite ground-height data&lt;br&gt;arrives at 30-metre detail and&lt;br&gt;is cached for offline reuse." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#14305A;strokeColor=#14305A;fontColor=#FFFFFF;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="210" y="272" width="172" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p6956_16" value="Like fetching a 3D photograph of the valley." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=5.9;fontStyle=2;align=center;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="210" y="444" width="172" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p6956_17" value="&lt;b&gt;3. Prepare the Land&lt;/b&gt;&lt;br&gt;Smooth the artefacts, locate the&lt;br&gt;dam wall, and label what covers&lt;br&gt;the ground downstream." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="394" y="272" width="180" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p6956_18" value="Forest slows water down; concrete speeds it up." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=5.9;fontStyle=2;align=center;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="394" y="444" width="180" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p6956_19" value="&lt;b&gt;4. Model the Break&lt;/b&gt;&lt;br&gt;Work out how wide the breach&lt;br&gt;grows, how quickly, and how much&lt;br&gt;water is released at the peak." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EA580C;strokeColor=#EA580C;fontColor=#FFFFFF;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="586" y="272" width="174" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p6956_20" value="Formulas drawn from decades of dam-safety study." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=5.9;fontStyle=2;align=center;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="586" y="444" width="174" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p6956_21" value="&lt;b&gt;5. Simulate the Flood&lt;/b&gt;&lt;br&gt;Follow the water downstream&lt;br&gt;second by second across the whole&lt;br&gt;landscape -- the core calculation." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#1E40AF;strokeColor=#1E40AF;fontColor=#FFFFFF;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="772" y="272" width="186" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p6956_22" value="The heavy step, and still only tens of seconds." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=5.9;fontStyle=2;align=center;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="772" y="444" width="186" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p6956_23" value="&lt;b&gt;6. Assess the Impact&lt;/b&gt;&lt;br&gt;Which areas flood, how deep,&lt;br&gt;when the water arrives, and how&lt;br&gt;many people are exposed." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="970" y="272" width="172" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p6956_24" value="Depth becomes consequence, in plain numbers." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=5.9;fontStyle=2;align=center;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="970" y="444" width="172" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p6956_25" value="&lt;b&gt;7. Publish Results&lt;/b&gt;&lt;br&gt;Maps, Google Earth overlays,&lt;br&gt;charts and downloadable reports,&lt;br&gt;ready for the people who decide." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=8.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1154" y="272" width="157" height="162" as="geometry" />
        </mxCell>
        <mxCell id="p6956_26" value="One run produces the whole package." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#FFFFFF;fontColor=#8D4D04;fontSize=5.9;fontStyle=2;align=center;verticalAlign=top;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1154" y="444" width="157" height="66" as="geometry" />
        </mxCell>
        <mxCell id="p6956_27" style="html=1;strokeColor=#0284C7;strokeWidth=1.8;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="198" y="353" as="sourcePoint" />
            <mxPoint x="210" y="353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6956_28" style="html=1;strokeColor=#0284C7;strokeWidth=1.8;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="382" y="353" as="sourcePoint" />
            <mxPoint x="394" y="353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6956_29" style="html=1;strokeColor=#0284C7;strokeWidth=1.8;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="574" y="353" as="sourcePoint" />
            <mxPoint x="586" y="353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6956_30" style="html=1;strokeColor=#0284C7;strokeWidth=1.8;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="760" y="353" as="sourcePoint" />
            <mxPoint x="772" y="353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6956_31" style="html=1;strokeColor=#0284C7;strokeWidth=1.8;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="958" y="353" as="sourcePoint" />
            <mxPoint x="970" y="353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6956_32" style="html=1;strokeColor=#0284C7;strokeWidth=1.8;endArrow=block;startArrow=none;rounded=0;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1142" y="353" as="sourcePoint" />
            <mxPoint x="1154" y="353" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="p6956_33" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4F4FD;strokeColor=#4F46E5;fontColor=#1F2937;fontSize=8;fontStyle=1;align=center;verticalAlign=middle;arcSize=3;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="22" y="544" width="1289" height="156" as="geometry" />
        </mxCell>
        <mxCell id="p6956_34" value="WHAT COMES OUT AT THE END" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=7.6;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="36" y="532" width="199" height="24" as="geometry" />
        </mxCell>
        <mxCell id="p6956_35" value="&lt;b&gt;Arrival Time Map&lt;/b&gt;&lt;br&gt;When the water reaches each&lt;br&gt;town -- the number that decides an evacuation order." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DC2626;strokeColor=#DC2626;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="42" y="572" width="242" height="114" as="geometry" />
        </mxCell>
        <mxCell id="p6956_36" value="&lt;b&gt;Inundation Envelope&lt;/b&gt;&lt;br&gt;The outer boundary of the flood, with a&lt;br&gt;fifth-to-ninety-fifth percentile band around it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0D9488;strokeColor=#0D9488;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="300" y="572" width="236" height="114" as="geometry" />
        </mxCell>
        <mxCell id="p6956_37" value="&lt;b&gt;Depth and Hazard Bands&lt;/b&gt;&lt;br&gt;Four hazard classes, from ankle-deep&lt;br&gt;through to above five metres." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EA580C;strokeColor=#EA580C;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="552" y="572" width="230" height="114" as="geometry" />
        </mxCell>
        <mxCell id="p6956_38" value="&lt;b&gt;People and Buildings Exposed&lt;/b&gt;&lt;br&gt;Counts drawn from satellite population&lt;br&gt;and building data, with the source stated." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#4F46E5;strokeColor=#4F46E5;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="798" y="572" width="244" height="114" as="geometry" />
        </mxCell>
        <mxCell id="p6956_39" value="&lt;b&gt;Evidence Pack&lt;/b&gt;&lt;br&gt;The quality-gate results and the&lt;br&gt;independent cross-check, attached to&lt;br&gt;every single run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#059669;strokeColor=#059669;fontColor=#FFFFFF;fontSize=7.8;fontStyle=1;align=center;verticalAlign=middle;arcSize=6;spacing=4;" vertex="1" parent="1">
          <mxGeometry x="1058" y="572" width="253" height="114" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page3" name="3. User Journey">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1333" pageHeight="750" math="0" shadow="0">
      <root>
        <mxCell id="0" />
