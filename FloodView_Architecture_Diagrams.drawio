        <mxCell id="p1211_19" value="EVERYTHING INSIDE THIS BOX IS JALRAKSHA" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0284C7;strokeColor=#0284C7;fontColor=#FFFFFF;fontSize=7.4;fontStyle=1;align=center;verticalAlign=middle;arcSize=30;spacing=4;" vertex="1" parent="1">
